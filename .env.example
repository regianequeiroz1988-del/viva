# ─────────────────────────────────────────────────────────────────────────────
# Viva Sorte — variáveis de ambiente
#
# Local:  copie este arquivo para ".env" e preencha.
# Vercel: cadastre as mesmas chaves em Settings > Environment Variables.
#
# O ".env" está no .gitignore — NUNCA versione chaves reais.
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. SUPABASE (obrigatório) ────────────────────────────────────────────────
# Painel do Supabase > Project Settings > API

# Front-end (públicas, protegidas por RLS). Precisam do prefixo VITE_ para o
# Vite injetar no bundle.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=COLE_AQUI_A_CHAVE_ANON_PUBLIC

# Back-end (as funções em api/ leem estas). SUPABASE_URL/ANON_KEY podem repetir
# os valores acima; o código cai para as VITE_ se estas faltarem.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=COLE_AQUI_A_CHAVE_ANON_PUBLIC

# ⚠️ SECRETA — ignora RLS. Só no servidor, jamais com prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_CHAVE_SERVICE_ROLE


# ── 2. LOGIN POR CPF (obrigatório se usar /api/auth-cpf) ─────────────────────
# Segredo do HMAC que deriva a senha do Supabase Auth a partir do CPF.
# Defina UMA vez e nunca troque — trocar invalida o login de todo mundo.
# Gere com: openssl rand -hex 32
AUTH_CPF_SECRET=

# Domínio fictício dos e-mails sintéticos (padrão: cpf.vivasorte.app)
AUTH_CPF_EMAIL_DOMAIN=


# ── 3. URLs DO SITE ──────────────────────────────────────────────────────────
# Usadas em links de retorno do PIX e nos e-mails. Na Vercel, se ficarem vazias,
# o código usa VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL automaticamente.
PUBLIC_SITE_URL=
SITE_URL=


# ── 4. GATEWAYS DE PAGAMENTO (opcionais) ─────────────────────────────────────
# Todos também podem ser cadastrados em /admin > Configurações (gravam no banco).
# A env tem prioridade sobre o valor do banco. Preencha só o gateway que usar.

# Pagar.me
PAGARME_SECRET_KEY=
PAGARME_WEBHOOK_SECRET=

# PayForge
PAYFORGE_PUBLIC_KEY=
PAYFORGE_SECRET_KEY=
PAYFORGE_WEBHOOK_SECRET=

# BravoPay
BRAVOPAY_API_KEY=
BRAVOPAY_WEBHOOK_KEY=


# ── 5. E-MAIL TRANSACIONAL — Resend (opcional) ───────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=


# ── 6. RASTREAMENTO — UTMify (opcional) ──────────────────────────────────────
UTMIFY_API_TOKEN=


# ── 7. CONSULTA DE CPF — OwnData (opcional) ──────────────────────────────────
OWNDATA_TOKEN=
# Proxy só para o script local scripts/enriquecer-consultas.js
OWNDATA_PROXY=


# ── 8. SERVIDOR LOCAL (server.js) ────────────────────────────────────────────
PORT=3000
